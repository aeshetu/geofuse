{
  "settings": {
    "number_of_shards": 1,
    "number_of_replicas": 0
  },
  "mappings": {
    "dynamic": "strict",
    "properties": {
      "uid": {"type": "keyword"},
      "source": {"type": "keyword"},
      "source_id": {"type": "keyword"},
      "kind": {"type": "keyword"},
      "name": {"type": "text", "fields": {"raw": {"type": "keyword", "ignore_above": 256}}},
      "observed_at": {"type": "date"},
      "location": {"type": "geo_point"},
      "attributes": {"type": "flattened"},
      "run_id": {"type": "keyword"}
    }
  }
}
